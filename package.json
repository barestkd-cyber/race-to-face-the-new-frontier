{
  "name": "race-to-face-the-new-frontier",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Race to Face the New Frontier — V1 first playable. Mobile-first 2D pixel-art space survival RPG.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:single": "vite build --config vite.config.single.ts && node scripts/inline.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
